@startuml scenario
' Seething Sparrows - Scenario View (4+1)
' 
title Seething Sparrows — Scenario View

actor User
participant "Game" as Game
participant "Level Generator" as Level
participant "Collision Handler" as Collisions
participant "Ball\n(Object)" as Bird
participant "Pymunk Space" as Space

User -> Game: Initializes game
Game -> Level: Request first level
Level --> Game: Yield level entities

loop Level (Goal: 10-15)
    User -> Game: Drag & release slingshot
    Game -> Bird: Apply impulse from slingshot
    Bird -> Space: Update physics on bird

    loop Game Loop (60 FPS)
        Game -> Space: Move forward one frame
        Space --> Collisions: Detect collision
        Collisions -> Bird: Update velocity and position
        Collisions -> Game: Update score and check win
        Game --> User: Render next frame
    end

    User -> Game: Selects next level or retry
    Game -> Level: Request next level
    Level --> Game: Yield level entities
end

@enduml